@page "/chat"
@using Hellbot.UI.Services
@inject EventFeed Feed
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Unified chat</PageTitle>

<MudText Typo="Typo.h4" Class="mb-3">Unified chat</MudText>

<MudPaper Class="pa-3">
    <MudTable Items="Feed.ChatLines"
              Dense="true"
              Hover="true"
              Striped="true"
              Bordered="false"
              @key="Feed.ChatLines.Count">

        <HeaderContent>
            <MudTh>Timestamp</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>User</MudTh>
            <MudTh>Message</MudTh>
        </HeaderContent>

        <RowTemplate Context="row">
            <MudTd>@row.TimestampDisplay</MudTd>
            <MudTd>@row.Source</MudTd>
            <MudTd>@row.UserDisplay</MudTd>
            <MudTd Style="word-break:break-word;">@row.Message</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    protected override void OnInitialized()
    {
        Feed.Changed += OnFeedChanged;
    }

    private void OnFeedChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
