@page "/events"
@using Hellbot.Core.Events
@using Hellbot.UI.Components.Extensions
@using Hellbot.UI.Configuration
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Options
@using System.Text.Json
@inject IOptions<HellbotApiOptions> ApiOptions
@rendermode InteractiveServer

<h3>Live Events</h3>

<!-- FILTERS -->
<div style="margin-bottom:10px;">
    <b>Filter:</b>

    @foreach (var type in uniqueEventTypes.OrderBy(x => x))
    {
        <label style="margin-right:10px;">
            <input type="checkbox"
                   checked="@selectedTypes.Contains(type)"
                   @onchange="e => ToggleType(type, (bool)e.Value!)" />
            @type
        </label>
    }
</div>

<MudPaper Class="pa-3">

    <MudTable Items="ProcessedEvents"
              Dense="true"
              Hover="true"
              Striped="true"
              Bordered="false"
              @key="events.Count">

        <HeaderContent>
            <MudTh></MudTh>

            <MudTh Style="cursor:pointer" @onclick="() => SortBy(nameof(HubEventMessage.Type))">
                Type @(sortColumn == nameof(HubEventMessage.Type) ? (sortAsc ? "↑" : "↓") : "")
            </MudTh>

            <MudTh Style="cursor:pointer" @onclick="() => SortBy(nameof(HubEventMessage.Timestamp))">
                Timestamp @(sortColumn == nameof(HubEventMessage.Timestamp) ? (sortAsc ? "↑" : "↓") : "")
            </MudTh>

            <MudTh>Id</MudTh>
        </HeaderContent>

        <RowTemplate Context="evt">
            <MudTd>
                <MudIconButton Size="Size.Small"
                               Icon="@(expanded.Contains(evt.Id)
                                                                                   ? Icons.Material.Filled.Remove
                                                                                   : Icons.Material.Filled.Add)"
                               OnClick="@(() => ToggleDetails(evt.Id))" />
            </MudTd>

            <MudTd>
                @evt.Type
            </MudTd>

            <MudTd>
                @evt.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")
            </MudTd>

            <MudTd Style="font-size:0.75em; opacity:0.8;">
                @evt.Id
            </MudTd>
        </RowTemplate>

        <ChildRowContent Context="evt">
            @if (expanded.Contains(evt.Id))
            {
                <MudTr>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="white-space:pre-wrap; word-break:break-word;">
                            @if (evt.User is { } user)
                            {
                                <span style="opacity:0.9;">User: @(user.Username ?? user.UserId) (@user.Platform, @user.UserId)</span>
                                <span style="margin:0 0.5em;">|</span>
                            }
                            @FormatEventData(evt.Data)
                        </MudText>
                    </MudTd>
                </MudTr>
            }
        </ChildRowContent>

    </MudTable>

</MudPaper>

@code {

    // =========================
    // STATE
    // =========================

    private List<HubEventMessage> events = new();
    private HashSet<Guid> expanded = new();
    private HashSet<string> selectedTypes = new();
    private List<string> uniqueEventTypes = new();

    private string sortColumn = nameof(HubEventMessage.Timestamp);
    private bool sortAsc = false;

    private HubConnection? hubConnection;

    // =========================
    // INIT
    // =========================

    protected override async Task OnInitializedAsync()
    {
        var hubUrl = $"{ApiOptions.Value.BaseUrl.TrimEnd('/')}/eventsHub";
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<HubEventMessage>("ReceiveEvent", raw =>
        {
            var evt = raw.Id == Guid.Empty ? raw with { Id = Guid.NewGuid() } : raw;

            events.Insert(0, evt);

            if (!uniqueEventTypes.Contains(evt.Type))
            {
                uniqueEventTypes.Add(evt.Type);
                selectedTypes.Add(evt.Type); // auto-enable new types
            }

            if (events.Count > 100)
                events.RemoveAt(events.Count - 1);

            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    // =========================
    // FILTERED + SORTED DATA
    // =========================

    private IEnumerable<HubEventMessage> ProcessedEvents =>
        events
            .Where(e => selectedTypes.Count == 0 || selectedTypes.Contains(e.Type))
            .OrderByDynamic(sortColumn, sortAsc);

    // =========================
    // UI ACTIONS
    // =========================

    private void ToggleDetails(Guid id)
    {
        if (!expanded.Add(id))
            expanded.Remove(id);
    }

    private void ToggleType(string type, bool enabled)
    {
        if (enabled)
            selectedTypes.Add(type);
        else
            selectedTypes.Remove(type);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    private string FormatEventData(object data)
    {
        if (data is null)
            return "<null>";

        // If it's already a JSON element, pretty print it
        if (data is System.Text.Json.JsonElement json)
            return JsonSerializer.Serialize(json, new JsonSerializerOptions { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });

        // fallback
        return data.ToString() ?? "<empty>";
    }
}