@page "/events"
@using Hellbot.Core.Events
@using Hellbot.UI.Components.Extensions
@using Hellbot.UI.Services
@using System.Text.Json
@inject EventFeed Feed
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Live events</PageTitle>

<MudText Typo="Typo.h4" Class="mb-3">Live events</MudText>

<MudPaper Class="pa-3 mb-4" Outlined="true" Elevation="0">
    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">Filter by type</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        @foreach (var type in Feed.HubEvents.Select(e => e.Type).Distinct().OrderBy(x => x))
        {
            <MudCheckBox T="bool"
                         Value="@selectedTypes.Contains(type)"
                         ValueChanged="@(enabled => ToggleType(type, enabled))"
                         Label="@type"
                         Color="Color.Primary"
                         Dense="true" />
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-3">

    <MudTable Items="ProcessedEvents"
              Dense="true"
              Hover="true"
              Striped="true"
              Bordered="false"
              @key="Feed.HubEvents.Count">

        <HeaderContent>
            <MudTh></MudTh>

            <MudTh Style="cursor:pointer" @onclick="() => SortBy(nameof(HubEventMessage.Type))">
                Type @(sortColumn == nameof(HubEventMessage.Type) ? (sortAsc ? "↑" : "↓") : "")
            </MudTh>

            <MudTh Style="cursor:pointer" @onclick="() => SortBy(nameof(HubEventMessage.Timestamp))">
                Timestamp @(sortColumn == nameof(HubEventMessage.Timestamp) ? (sortAsc ? "↑" : "↓") : "")
            </MudTh>

            <MudTh>Id</MudTh>
        </HeaderContent>

        <RowTemplate Context="evt">
            <MudTd>
                <MudIconButton Size="Size.Small"
                               Icon="@(expanded.Contains(evt.Id)
                                                                                   ? Icons.Material.Filled.Remove
                                                                                   : Icons.Material.Filled.Add)"
                               OnClick="@(() => ToggleDetails(evt.Id))" />
            </MudTd>

            <MudTd>
                @evt.Type
            </MudTd>

            <MudTd>
                @evt.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")
            </MudTd>

            <MudTd Style="font-size:0.75em; opacity:0.8;">
                @evt.Id
            </MudTd>
        </RowTemplate>

        <ChildRowContent Context="evt">
            @if (expanded.Contains(evt.Id))
            {
                <MudTr>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="white-space:pre-wrap; word-break:break-word;">
                            @if (evt.User is { } user)
                            {
                                <span style="opacity:0.9;">User: @(user.Username ?? user.UserId) (@user.Platform, @user.UserId)</span>
                                <span style="margin:0 0.5em;">|</span>
                            }
                            @FormatEventData(evt.Data)
                        </MudText>
                    </MudTd>
                </MudTr>
            }
        </ChildRowContent>

    </MudTable>

</MudPaper>

@code {

    private HashSet<Guid> expanded = new();
    private HashSet<string> selectedTypes = new();
    private readonly HashSet<string> typesSeenForAutoSelect = new();

    private string sortColumn = nameof(HubEventMessage.Timestamp);
    private bool sortAsc = false;

    protected override void OnInitialized()
    {
        ApplyAutoSelectForNewTypes();
        Feed.Changed += OnFeedChanged;
    }

    private void OnFeedChanged()
    {
        ApplyAutoSelectForNewTypes();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Feed.Changed -= OnFeedChanged;

    /// <summary>
    /// First time we see an event type (in the shared feed), opt it into the filter selection — same as the old incremental hub callback.
    /// </summary>
    private void ApplyAutoSelectForNewTypes()
    {
        foreach (var t in Feed.HubEvents.Select(e => e.Type).Distinct())
        {
            if (typesSeenForAutoSelect.Add(t))
                selectedTypes.Add(t);
        }
    }

    private IEnumerable<HubEventMessage> ProcessedEvents =>
        Feed.HubEvents
            .Where(e => selectedTypes.Count == 0 || selectedTypes.Contains(e.Type))
            .OrderByDynamic(sortColumn, sortAsc);

    private void ToggleDetails(Guid id)
    {
        if (!expanded.Add(id))
            expanded.Remove(id);
    }

    private void ToggleType(string type, bool enabled)
    {
        if (enabled)
            selectedTypes.Add(type);
        else
            selectedTypes.Remove(type);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    private string FormatEventData(object data)
    {
        if (data is null)
            return "<null>";

        if (data is JsonElement json)
            return JsonSerializer.Serialize(json, new JsonSerializerOptions {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });

        return data.ToString() ?? "<empty>";
    }
}
