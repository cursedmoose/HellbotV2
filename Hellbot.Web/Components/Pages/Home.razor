@page "/"
@using Hellbot.Core.Events.Session
@using Hellbot.UI.Services
@inject EventFeed Feed
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Hellbot</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-3 d-flex flex-column"
                  Elevation="2"
                  Style="height: 280px; overflow: hidden;">
            <div class="d-flex align-center justify-space-between mb-2 flex-shrink-0">
                <MudText Typo="Typo.h6">Service status</MudText>
                <MudLink Href="service-status" Typo="Typo.caption">Details</MudLink>
            </div>
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <MudTable Items="@Feed.ServiceStatusRows"
                          Dense="true"
                          Hover="true"
                          Bordered="false"
                          @key="Feed.ServiceStatusTableVersion">
                <HeaderContent>
                    <MudTh>Platform</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd>@row.Platform</MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@StatusColor(row.Status)">
                            @row.Status
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-3 d-flex flex-column"
                  Elevation="2"
                  Style="height: 280px; overflow: hidden;">
            <div class="d-flex align-center justify-space-between mb-2 flex-shrink-0">
                <MudText Typo="Typo.h6">Event feed</MudText>
                <MudLink Href="events" Typo="Typo.caption">Live feed</MudLink>
            </div>
            <div class="flex-grow-1" style="min-height: 0; overflow-y: auto;">
                <MudTable Items="@Feed.HubEvents"
                          Dense="true"
                          Hover="true"
                          Bordered="false"
                          @key="Feed.HubEvents.Count">
                    <HeaderContent>
                        <MudTh>Timestamp</MudTh>
                        <MudTh>Type</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="evt">
                        <MudTd Style="white-space: nowrap;">
                            @evt.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")
                        </MudTd>
                        <MudTd Style="word-break:break-word;">@evt.Type</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-3 d-flex flex-column"
                  Elevation="2"
                  Style="height: 420px; overflow: hidden;">
            <div class="d-flex align-center justify-space-between mb-2 flex-shrink-0">
                <MudText Typo="Typo.h6">Unified chat</MudText>
                <MudLink Href="chat" Typo="Typo.caption">Table view</MudLink>
            </div>
            <div @ref="_chatScrollRegion"
                 class="flex-grow-1 mud-typography-body2"
                 style="min-height: 0; overflow-y: auto; font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace; line-height: 1.45;">
                @foreach (var row in Feed.ChatLines)
                {
                    <div class="mb-1" style="word-break: break-word;" @key="@($"{row.TimestampDisplay}|{row.UserDisplay}|{row.Source}|{row.Message}")">
                        <strong>@row.UserDisplay</strong><span> [@row.Source]: </span>@row.Message
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private ElementReference _chatScrollRegion;
    private IJSObjectReference? _chatScrollJs;
    private int _chatLineCountSnapshot;
    private bool _scrollChatAfterRender;

    protected override async Task OnInitializedAsync()
    {
        await Feed.EnsureServiceStatusSnapshotAsync();
        _chatLineCountSnapshot = Feed.ChatLines.Count;
        Feed.Changed += OnFeedChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _chatScrollJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-scroll.js");
            }
            catch
            {
                return;
            }

            if (Feed.ChatLines.Count > 0)
                _scrollChatAfterRender = true;
        }

        if (!_scrollChatAfterRender || _chatScrollJs is null)
            return;

        try
        {
            await _chatScrollJs.InvokeVoidAsync("scrollToBottom", _chatScrollRegion);
        }
        catch
        {
            // Ignore during prerender or before the scroll region exists.
        }

        _scrollChatAfterRender = false;
    }

    private void OnFeedChanged() =>
        _ = InvokeAsync(async () =>
        {
            var count = Feed.ChatLines.Count;
            var grew = count > _chatLineCountSnapshot;
            _chatLineCountSnapshot = count;

            if (grew)
            {
                if (_chatScrollJs is null)
                    _scrollChatAfterRender = true;
                else
                {
                    try
                    {
                        _scrollChatAfterRender =
                            await _chatScrollJs.InvokeAsync<bool>("isNearBottom", _chatScrollRegion);
                    }
                    catch
                    {
                        _scrollChatAfterRender = false;
                    }
                }
            }

            StateHasChanged();
        });

    public async ValueTask DisposeAsync()
    {
        Feed.Changed -= OnFeedChanged;
        if (_chatScrollJs is not null)
            await _chatScrollJs.DisposeAsync();
    }

    private static Color StatusColor(ConnectionState status) => status switch
    {
        ConnectionState.Connected => Color.Success,
        ConnectionState.Disconnected => Color.Error,
        _ => Color.Default
    };
}
