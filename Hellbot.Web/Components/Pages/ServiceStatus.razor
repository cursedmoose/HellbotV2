@page "/service-status"
@using Hellbot.Core.Events.Session
@using Hellbot.UI.Services
@inject EventFeed Feed
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Service status</PageTitle>

<MudText Typo="Typo.h4" Class="mb-3">Service status</MudText>

<MudPaper Class="pa-3">
    <MudTable Items="@Feed.ServiceStatusRows"
              Dense="true"
              Hover="true"
              Striped="true"
              Bordered="false"
              @key="Feed.ServiceStatusTableVersion">

        <HeaderContent>
            <MudTh>Platform</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Details</MudTh>
            <MudTh>Last change</MudTh>
        </HeaderContent>

        <RowTemplate Context="row">
            <MudTd>@row.Platform</MudTd>
            <MudTd>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@StatusColor(row.Status)">
                    @row.Status
                </MudChip>
            </MudTd>
            <MudTd Style="max-width:320px; word-break:break-word;">@(row.Details ?? "—")</MudTd>
            <MudTd>@row.LastChanged.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Feed.EnsureServiceStatusSnapshotAsync();
        Feed.Changed += OnFeedChanged;
    }

    private void OnFeedChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.Changed -= OnFeedChanged;

    private static Color StatusColor(ConnectionState status) => status switch
    {
        ConnectionState.Connected => Color.Success,
        ConnectionState.Disconnected => Color.Error,
        _ => Color.Default
    };
}
