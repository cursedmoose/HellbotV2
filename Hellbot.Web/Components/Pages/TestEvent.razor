@page "/events/test"
@rendermode InteractiveServer

@inject IHttpClientFactory HttpFactory

<PageTitle>Test event</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Test event</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendTestEvent">Send test event</MudButton>

<MudText Typo="Typo.body2" Class="mt-3" role="status">Current count: @currentCount</MudText>

@code {
    private int currentCount = 0;

    private async void SendTestEvent()
    {
        currentCount++;
        var client = HttpFactory.CreateClient("api");

        await client.PostAsJsonAsync("api/events/test", new
        {
            Message = "MANUAL PING"
        });
    }
}